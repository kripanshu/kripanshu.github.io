---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/Prompt.astro';
import Cursor from '../components/Cursor.astro';
---

<BaseLayout
  title="Kripanshu Bhargava"
  description="Software engineer."
  path="~/"
>
  <Prompt as="h1" command="whoami" />
  <p>Kripanshu Bhargava — software engineer.</p>

  <Prompt command="echo 'landing page coming next commit'" />
  <p class="dim">
    Theme + base layout shipped. Real content lands in commit #3.
    <Cursor />
  </p>
</BaseLayout>

<style>
  .dim {
    color: var(--text-dim);
  }
</style>
